{
  "name": "madrasah-at-towfiq-portal",
  "version": "1.0.15",
  "private": true,
  "type": "module",
  "description": "Masjid At-Towfiq Madrasah student management portal with D1 and session authentication",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply attowfiq_portal --local",
    "db:migrate:remote": "wrangler d1 migrations apply attowfiq_portal --remote",
    "preview": "node --no-warnings scripts/local-preview.mjs",
    "test": "node --no-warnings scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.53.0"
  }
}