
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "madrasah-at-towfiq-portal",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "triggers": {
    "crons": [
      "0 8 * * 5"
    ]
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "attowfiq_portal",
      "database_id": "d5806f7e-9c9f-4ba5-a168-6215d3e63415",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "EMAIL_FROM": "Madrasah At-Towfiq <notifications@example.org>",
    "SCHOOL_NAME": "Madrasah At-Towfiq"
  }
}
